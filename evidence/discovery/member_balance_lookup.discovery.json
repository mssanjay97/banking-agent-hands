{
  "goal": "Find member 12345 and retrieve their savings balance.",
  "start_url": "http://127.0.0.1:3000/members",
  "actions": [
    {
      "action": "fill",
      "target": {
        "role": "input",
        "name": "Member ID",
        "id": "member-id",
        "selector": "input#member-id"
      },
      "value": "{{member_id}}",
      "output": "Member ID filled with 12345"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Search",
        "id": null,
        "selector": "button[type=\"submit\"]"
      },
      "value": "Search",
      "output": "Search button clicked"
    },
    {
      "action": "extract",
      "target": {
        "role": "paragraph",
        "name": "Savings Balance",
        "id": null,
        "selector": "[data-field='savings-balance']"
      },
      "output": "extracted_value"
    }
  ]
}