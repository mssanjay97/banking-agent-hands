{
  "id": "member_not_found_test",
  "version": "1.0",
  "goal": "Find member 99999 and retrieve their savings balance.",
  "start_url": "http://127.0.0.1:3000/members",
  "surface": {
    "type": "web",
    "vendor": "demo-core-banking",
    "tenant": "demo",
    "base_url": "http://127.0.0.1:3000/members",
    "version": "1.0"
  },
  "inputs": {
    "member_id": {
      "type": "string",
      "required": true
    }
  },
  "steps": [
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": "Member ID",
        "id": "member-id",
        "selector": "input#member-id"
      },
      "value": "{{member_id}}",
      "output": "Member ID filled with 99999"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Search",
        "id": null,
        "selector": "button[type=\"submit\"]"
      },
      "value": null,
      "output": "Search button clicked"
    }
  ],
  "outputs": {},
  "checkpoint": {
    "type": "element_present",
    "target": {
      "role": "button",
      "name": "Search",
      "id": null,
      "selector": "button[type=\"submit\"]"
    }
  },
  "business_outcomes": [
  {
    "signal": "Member not found.",
    "status": "BUSINESS_OUTCOME"
  }
]
}