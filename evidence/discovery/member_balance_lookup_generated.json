{
  "id": "member-balance-lookup",
  "version": "1.0",
  "surface": {
    "type": "web",
    "vendor": "demo-core-banking",
    "tenant": "demo",
    "base_url": "http://127.0.0.1:3000",
    "version": "1.0"
  },
  "inputs": {
    "member_id": {
      "type": "string",
      "required": true
    }
  },
  "steps": [
    {
      "action": "navigate",
      "target": "http://127.0.0.1:3000/members",
      "value": null,
      "output": null
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": "Member ID"
      },
      "value": "{{member_id}}",
      "output": null
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Search"
      },
      "value": null,
      "output": null
    },
    {
      "action": "extract",
      "target": {
        "selector": "[data-field='savings-balance']"
      },
      "value": null,
      "output": "savings_balance"
    }
  ],
  "outputs": {
    "savings_balance": {
      "type": "string"
    }
  },
  "checkpoint": {
    "type": "element_present",
    "target": {
      "role": null,
      "name": null,
      "id": null,
      "selector": "[data-field='savings-balance']"
    }
  },
  "business_outcomes": [
    {
      "signal": "Member not found.",
      "status": "MEMBER_NOT_FOUND"
    }
  ]
}